{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "portable-skill-capabilities.schema.json",
  "title": "Portable Skill Capability Manifest",
  "type": "object",
  "required": ["schema", "schema_version", "skill", "target_platforms", "capabilities"],
  "properties": {
    "schema": {"const": "portable-skill-capabilities"},
    "schema_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "skill": {"type": "string", "minLength": 1},
    "target_platforms": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"}},
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "purpose", "required", "required_features", "input_fields", "output_fields", "side_effects"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)+$"},
          "purpose": {"type": "string", "minLength": 1},
          "required": {"type": "boolean"},
          "required_features": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "input_fields": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "output_fields": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "side_effects": {"type": "object"}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
